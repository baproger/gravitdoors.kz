# Боевые настройки под маленький сервер (1 ГБ памяти, 2 vCPU, 15 ГБ диска).
# Скопировать в .env на сервере и заполнить APP_KEY, APP_URL и пароли.

APP_NAME="Gravit ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.gravit.kz
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_TIMEZONE=Asia/Almaty

# Логи: по дням, 7 дней, только предупреждения и ошибки. Отладочный уровень
# за месяц съедает гигабайт диска.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

# База — MySQL хостинга (hoster.kz выдаёт хост, имя базы, логин и пароль
# в панели). Кодировка utf8mb4 задана в config/database.php. Набор тестов
# проходит на MySQL 8+/9 и на SQLite одинаково, локально можно оставлять SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gravit
DB_USERNAME=gravit
DB_PASSWORD=

# Если база всё же SQLite (свой VPS без MySQL) — раскомментировать вместо блока выше:
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/gravit/database/database.sqlite
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_BUSY_TIMEOUT=5000

# Кэш и сессии — в файлах: не тратим базу на каждое чтение настроек и прав,
# и не держим отдельный процесс Redis ради 40 МБ памяти.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
# Кука сессии только по HTTPS и недоступна скриптам.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Прокси, которому верим про HTTPS: nginx хостинга на той же машине.
TRUSTED_PROXIES=127.0.0.1,::1

# Очередь синхронная: задач, которым нужен фон, в системе нет, а воркер —
# это ещё один PHP-процесс на 40–60 МБ, который на 1 ГБ лучше не держать.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# Почта пока не используется; оставлено для будущих уведомлений.
MAIL_MAILER=log

# Пороги утренней проверки сервера (gravit:server-check, 08:00): ниже них
# директору приходит уведомление. Бэкап файлов тоже пропускается, если после
# него на диске осталось бы меньше GRAVIT_MIN_FREE_DISK_MB.
GRAVIT_MIN_FREE_DISK_MB=1500
GRAVIT_MIN_FREE_MEMORY_MB=150
# GRAVIT_BACKUP_DIR=/var/backups/gravit   # если копии лежат не в storage/backups

VITE_APP_NAME="${APP_NAME}"
